# MinIO root user = S3 key pair used by every component (secret must be >= 8 chars)
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password
AWS_REGION=us-east-1
# Reference values for your own scripts (not substituted by compose)
S3_ENDPOINT=http://minio:9000
WAREHOUSE=s3://warehouse/
NESSIE_URI=http://nessie:19120/api/v2
NESSIE_ICEBERG_REST_URI=http://nessie:19120/iceberg/main
